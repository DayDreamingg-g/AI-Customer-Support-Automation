    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  t.id,\n  t.user_id,\n  t.name,\n  t.email,\n  t.subject,\n  t.message,\n  t.order_id,\n  t.product,\n  t.status,\n  t.created_at,\n  t.updated_at,\n  COALESCE(\n    array_agg(tt.tag) FILTER (WHERE tt.tag IS NOT NULL),\n    '{}'\n  ) AS tags\nFROM tickets t\nLEFT JOIN ticket_tags tt ON t.id = tt.ticket_id\nWHERE t.id = {{  $('Create Support Ticket').item.json.id }}\nGROUP BY t.id",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1936,
        -16
      ],
